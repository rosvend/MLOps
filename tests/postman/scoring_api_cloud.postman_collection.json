    },
    {
      "name": "3. Security and monitoring",
      "item": [
        {
          "name": "Security: no token is refused",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Proves the service is private. This request sends no Authorization header."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"the private service refuses a call without a token (401 or 403)\", () => pm.expect(pm.response.code).to.be.oneOf([401,403]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Monitoring: drift check",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/monitoring/run-drift-check",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "monitoring",
                "run-drift-check"
              ]
            },
            "description": "Runs Evidently inside the API on the rows logged in BigQuery. It can take 10 to 40 s."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 (a result) or 409 (not enough logged rows yet)\", () => pm.expect(pm.response.code).to.be.oneOf([200,409]));",
                  "if (pm.response.code === 200) { const b = pm.response.json();",
                  "  pm.test(\"has the drift summary\", () => { pm.expect(b.dataset_drift_detected).to.be.a(\"boolean\"); pm.expect(b.drift_share).to.be.within(0,1); pm.expect(b.current_rows).to.be.above(29); }); }"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}